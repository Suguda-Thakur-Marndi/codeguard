# ==============================================================================
# CodeGuard — Phase 1 Environment Configuration
# ==============================================================================

# Application Environment: development | staging | production | test
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Service URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://codeguard:codeguard_secret@localhost:5432/codeguard
POSTGRES_USER=codeguard
POSTGRES_PASSWORD=codeguard_secret
POSTGRES_DB=codeguard

# Redis Connection (Celery broker & result backend)
REDIS_URL=redis://localhost:6379/0

# GitHub App Integration Credentials
# Create your GitHub App at https://github.com/settings/apps
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=your-app-slug-here
GITHUB_APP_CLIENT_ID=Iv1.your_client_id_here
GITHUB_APP_INSTALL_URL=""
GITHUB_CLIENT_ID=Iv1.your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# GitHub App Private Key (PEM format RSA private key generated in GitHub App settings)
# Provide either GITHUB_PRIVATE_KEY_PATH (path to .pem file) or GITHUB_PRIVATE_KEY (raw string):
GITHUB_PRIVATE_KEY_PATH=your-app.private-key.pem
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Review Job Execution Settings
IGNORE_DRAFT_PRS=false
CELERY_TASK_ALWAYS_EAGER=false

# Gemini AI Provider & Cost Controls
# Get your API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_REASONING=gemini-2.5-pro
AGENT_MAX_CONCURRENCY=4

# Human Approval Settings
APPROVAL_EXPIRY_MINUTES_DEFAULT=60

# Google OAuth 2.0 Credentials (User Authentication)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=insecure-dev-secret-key-change-in-production-32bytes
# Development Auth Bypass: STRICTLY FORBIDDEN in staging/production.
# Only permitted through explicit local opt-in in development or test environments.
DEV_AUTH_BYPASS=false
DEV_AUTH_TOKEN=codeguard-dev-token
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

